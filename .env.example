# ─────────────────────────────────────────────────────────────────────────────
# Pegn-AI — 環境變數範本
# 複製此檔案為 .env 並填入實際值：cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Docker Compose 內部網路使用 postgres hostname；本地開發用 localhost
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_native
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# 生產環境必須設定為隨機長字串（最少 32 字元）
JWT_SECRET=change_me_to_a_random_32char_string_in_production
JWT_EXPIRES_IN=7d
SESSION_SECRET=change_me_too_at_least_32_chars

# ── AI ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 控制 Prompt 測試時使用的 LLM：auto | gemini | openai | mock
PROMPT_OPS_LLM_PROVIDER=auto

# ── OAuth（可選）──────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
API_PORT=4000
SYNC_PORT=1234
APP_ROLE=all
CORS_ORIGIN=http://localhost:80
FRONTEND_URL=http://localhost:80

# ── GCP Deployment (Cloud Run) ────────────────────────────────────────────────
# 部署到 GCP 的必要變數
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-east1
CLOUD_SQL_CONNECTION_NAME=your-gcp-project-id:asia-east1:pegn-ai-db
DB_USER=pegn_user
DB_PASS=change_me_secure_db_password
DB_NAME=ai_native
