# Copy this file to apps/server/.env.cloudrun and fill values before deploy.

NODE_ENV=production
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# Use Cloud SQL connection or public PG URL with SSL as needed
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# CORS: set your deployed web Cloud Run URL after first deploy, then redeploy API
CORS_ORIGIN=https://YOUR_WEB_SERVICE_URL
FRONTEND_URL=https://YOUR_WEB_SERVICE_URL
PUBLIC_URL=https://YOUR_API_SERVICE_URL

# AI provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Feature flags
INVITES_V1=true
SUPERVISOR_V1=true
KNOWLEDGE_ROUTER_V1=true
COMMENTS_V1=true
PWA_OFFLINE_V1=true
PWA_OFFLINE_V1_PERCENT=100

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
